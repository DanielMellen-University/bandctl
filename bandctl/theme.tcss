Screen {
    background: #2a2a2a;
    color: #e8e8e8;
}

/* Scrollbars in the same greys as the panels, green while dragged. */
#procs, #log {
    scrollbar-background: #2a2a2a;
    scrollbar-background-hover: #2a2a2a;
    scrollbar-background-active: #2a2a2a;
    scrollbar-color: #555555;
    scrollbar-color-hover: #8fd19a;
    scrollbar-color-active: #8fd19a;
    scrollbar-corner-color: #2a2a2a;
}

#banner {
    display: none;
    height: 1;
    background: #f0a35e;
    color: #1a1a1a;
    padding: 0 1;
}

#banner.-show {
    display: block;
}

#titlebar {
    height: 1;
    background: #333333;
    color: #8fd19a;
    padding: 0 1;
}

#capacity {
    height: 3;
}

#speed {
    width: 1fr;
    min-width: 16;
    height: 3;
    content-align: left middle;
    color: #e8e8e8;
    padding: 0 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#down-budget, #up-budget {
    width: 18;
    max-width: 40%;
}

#filter {
    height: 3;
}

#procs {
    height: 1fr;
    min-height: 3;
    background: #2a2a2a;
    color: #e8e8e8;
    overflow-x: hidden;
    scrollbar-size-vertical: 1;
}

#procs > .datatable--header {
    background: #333333;
    color: #8fd19a;
    text-style: bold;
}

#procs > .datatable--cursor {
    background: #8fd19a;
    color: #1a1a1a;
}

#procs:focus > .datatable--cursor {
    background: #8fd19a;
    color: #1a1a1a;
    text-style: bold;
}

#procs > .datatable--even-row {
    background: #303030;
}

#detail {
    height: 6;
    background: #333333;
    padding: 0 1;
}

#detail-controls {
    width: 1fr;
    height: 1fr;
}

#meters {
    width: 1fr;
    height: 1fr;
}

#detail-title, #down-caption, #up-caption {
    height: 1;
    color: #e8e8e8;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.meter {
    height: 2;
}

.meter-values {
    height: 1;
    width: 1fr;
}

.history {
    width: 1fr;
    max-width: 60;
    height: 1;
    color: #8fd19a;
    padding-left: 1;
    text-wrap: nowrap;
}

#pct-row {
    height: 3;
}

#pct-row Label {
    width: auto;
    height: 3;
    content-align: left middle;
    padding: 0 1;
}

#down-pct, #up-pct {
    width: 8;
}

#apply, #remove {
    width: 10;
    min-width: 10;
}

Input {
    background: #2a2a2a;
    color: #e8e8e8;
    border: tall #8fd19a;
}

Input:focus {
    border: tall #f0a35e;
}

Button {
    background: #2a2a2a;
    color: #8fd19a;
    border: tall #8fd19a;
}

Button:hover {
    background: #8fd19a;
    color: #1a1a1a;
}

#remove {
    color: #f0a35e;
    border: tall #f0a35e;
}

#remove:hover {
    background: #f0a35e;
    color: #1a1a1a;
}

ProgressBar {
    width: 1fr;
    height: 1;
    padding: 0;
}

Bar {
    width: 1fr;
}

Bar > .bar--bar {
    color: #8fd19a;
    background: #242424;
}

ProgressBar.hot Bar > .bar--bar {
    color: #f0a35e;
}

#log {
    height: 5;
    background: #242424;
    color: #e8e8e8;
    border: round #3a3a3a;
    overflow-x: hidden;
    overflow-y: auto;
    scrollbar-size-vertical: 1;
}

#status {
    height: 1;
    background: #3a3a3a;
    color: #ffffff;
    text-style: bold;
    padding: 0 1;
}

Footer {
    background: #3a3a3a;
    color: #ffffff;
}

FooterKey {
    margin-right: 1;
    background: #3a3a3a;
    color: #ffffff;
}

FooterKey .footer-key--key {
    background: #8fd19a;
    color: #1a1a1a;
    text-style: bold;
    padding: 0 1;
}

FooterKey .footer-key--description {
    background: #3a3a3a;
    color: #ffffff;
    padding: 0 1 0 0;
}

FooterLabel {
    color: #ffffff;
    background: #3a3a3a;
    text-style: bold;
}

RootRequired {
    align: center middle;
    background: #2a2a2a 70%;
}

RulesScreen {
    align: center middle;
    background: #2a2a2a 70%;
}

#rules-dialog {
    width: 92%;
    max-width: 76;
    height: 95%;
    min-height: 17;
    max-height: 24;
    background: #333333;
    border: round #8fd19a;
    padding: 0 1;
}

#rules-title {
    height: 1;
    color: #8fd19a;
    text-style: bold;
}

#rules-help, #rule-status {
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#rule-status {
    color: #8fd19a;
}

#rule-status.-error {
    color: #f0a35e;
}

#rule-table {
    height: 1fr;
    min-height: 3;
    overflow-x: hidden;
}

#rule-table > .datatable--header {
    background: #333333;
    color: #8fd19a;
    text-style: bold;
}

#rule-table > .datatable--cursor {
    background: #8fd19a;
    color: #1a1a1a;
}

#rule-fields, #rule-times, #rule-buttons {
    height: 3;
}

#rule-times Input {
    width: 1fr;
}

#rule-name {
    width: 1fr;
}

#rule-down, #rule-up {
    width: 12;
}

#rule-buttons Button {
    min-width: 10;
    width: 10;
    margin-right: 1;
}

#dialog {
    width: 70%;
    max-width: 72;
    height: auto;
    background: #333333;
    border: round #f0a35e;
    padding: 1 2;
}

#root-title {
    text-style: bold;
    color: #f0a35e;
    height: 1;
}

#root-body, #root-command {
    height: auto;
    color: #e8e8e8;
}

#root-command {
    color: #8fd19a;
    text-style: bold;
}

#too-small {
    display: none;
}

.-stacked #detail {
    layout: vertical;
    height: 8;
}

.-stacked #detail-controls,
.-stacked #meters {
    width: 100%;
    height: auto;
}

/* Fewer than 32 rows: one-row inputs and buttons with a colored edge
   instead of a full border, meters on one line each. */

.-compact #capacity {
    height: 1;
}

.-compact.-stacked #capacity {
    height: 2;
}

.-compact #speed {
    height: 100%;
    content-align: left top;
}

.-compact Input {
    height: 1;
    border: none;
    border-left: outer #8fd19a;
    padding: 0 1;
    background: #333333;
}

.-compact Input:focus {
    border-left: outer #f0a35e;
    background: #3d3a35;
}

.-compact #capacity Input {
    width: 14;
    margin-left: 1;
}

.-compact #filter {
    height: 1;
}

.-compact #pct-row {
    height: 1;
}

.-compact #pct-row Label {
    height: 1;
}

.-compact #down-pct, .-compact #up-pct {
    width: 7;
}

.-compact #pct-row Button {
    height: 1;
    min-width: 9;
    width: 9;
    margin-left: 1;
    border: none;
    background: #3a3a3a;
    text-style: bold;
}

.-compact #remove {
    border: none;
}

.-compact .meter {
    layout: horizontal;
    height: 1;
}

.-compact #down-caption, .-compact #up-caption {
    width: auto;
    max-width: 55%;
    padding: 0 1 0 0;
}

.-compact #detail {
    height: 2;
}

.-compact.-stacked #detail {
    height: 4;
}

.-compact #log {
    height: 3;
    border: none;
    padding: 0 1;
}

.-short #log {
    height: 2;
}

/* Fewer than 80 columns: tighter footer so every key still fits. */

.-narrow FooterKey {
    margin-right: 0;
}

.-narrow FooterKey .footer-key--key {
    padding: 0;
}

.-narrow FooterKey .footer-key--description {
    padding: 0 1;
}

.-tall #log {
    height: 7;
}

.-too-small #banner,
.-too-small #titlebar,
.-too-small #capacity,
.-too-small #filter,
.-too-small #procs,
.-too-small #detail,
.-too-small #log,
.-too-small #status,
.-too-small Footer {
    display: none;
}

.-too-small #too-small {
    display: block;
    dock: top;
    width: 100%;
    height: 100%;
    background: #2a2a2a;
    color: #ffffff;
    content-align: center middle;
    text-align: center;
    text-style: bold;
    padding: 1 2;
}

GroupsScreen {
    align: center middle;
    background: #2a2a2a 70%;
}

#group-dialog {
    width: 92%;
    max-width: 76;
    height: 95%;
    min-height: 17;
    max-height: 24;
    background: #333333;
    border: round #8fd19a;
    padding: 0 1;
}

#group-title { height: 1; color: #8fd19a; text-style: bold; }
#group-help, #group-status { height: 1; text-wrap: nowrap; text-overflow: ellipsis; }
#group-status { color: #8fd19a; }
#group-status.-error { color: #f0a35e; }
#group-table { height: 1fr; min-height: 3; overflow-x: hidden; }
#group-table > .datatable--header { background: #333333; color: #8fd19a; text-style: bold; }
#group-table > .datatable--cursor { background: #8fd19a; color: #1a1a1a; }
#group-fields, #group-shares, #group-buttons { height: 3; }
#group-fields Input, #group-shares Input { width: 1fr; }
#group-buttons Button { min-width: 10; width: 10; margin-right: 1; }
