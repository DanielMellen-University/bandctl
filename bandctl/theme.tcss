Screen {
    background: #2a2a2a;
    color: #e8e8e8;
}

#banner {
    display: none;
    height: 1;
    background: #f0a35e;
    color: #1a1a1a;
    padding: 0 1;
}

#banner.-show {
    display: block;
}

#titlebar {
    height: 1;
    background: #333333;
    color: #8fd19a;
    padding: 0 1;
}

#capacity {
    height: 3;
}

#speed {
    width: 1fr;
    min-width: 16;
    height: 3;
    content-align: left middle;
    color: #e8e8e8;
    padding: 0 1;
}

#down-budget, #up-budget {
    width: 18;
    max-width: 40%;
}

#filter {
    height: 3;
}

#procs {
    height: 1fr;
    background: #2a2a2a;
    color: #e8e8e8;
}

#procs > .datatable--header {
    background: #333333;
    color: #8fd19a;
    text-style: bold;
}

#procs > .datatable--cursor {
    background: #8fd19a;
    color: #1a1a1a;
}

#procs:focus > .datatable--cursor {
    background: #8fd19a;
    color: #1a1a1a;
    text-style: bold;
}

#procs > .datatable--even-row {
    background: #303030;
}

#detail {
    height: 6;
    background: #333333;
    padding: 0 1;
}

#detail-controls {
    width: 1fr;
    height: 1fr;
}

#meters {
    width: 1fr;
    height: 1fr;
}

#detail-title, #down-caption, #up-caption {
    height: 1;
    color: #e8e8e8;
}

#pct-row {
    height: 3;
}

#pct-row Label {
    width: auto;
    height: 3;
    content-align: left middle;
    padding: 0 1;
}

#down-pct, #up-pct {
    width: 8;
}

#apply, #remove {
    width: 9;
    min-width: 9;
}

Input {
    background: #2a2a2a;
    color: #e8e8e8;
    border: tall #8fd19a;
}

Input:focus {
    border: tall #f0a35e;
}

Button {
    background: #2a2a2a;
    color: #8fd19a;
    border: tall #8fd19a;
}

Button:hover {
    background: #8fd19a;
    color: #1a1a1a;
}

#remove {
    color: #f0a35e;
    border: tall #f0a35e;
}

#remove:hover {
    background: #f0a35e;
    color: #1a1a1a;
}

ProgressBar {
    width: 1fr;
    height: 1;
    padding: 0;
}

Bar {
    width: 1fr;
}

Bar > .bar--bar {
    color: #8fd19a;
    background: #242424;
}

ProgressBar.hot Bar > .bar--bar {
    color: #f0a35e;
}

#log {
    height: 5;
    background: #242424;
    color: #e8e8e8;
    border: round #3a3a3a;
}

#status {
    height: 1;
    background: #3a3a3a;
    color: #ffffff;
    text-style: bold;
    padding: 0 1;
}

Footer {
    background: #3a3a3a;
    color: #ffffff;
}

FooterKey {
    margin-right: 1;
    background: #3a3a3a;
    color: #ffffff;
}

FooterKey .footer-key--key {
    background: #8fd19a;
    color: #1a1a1a;
    text-style: bold;
    padding: 0 1;
}

FooterKey .footer-key--description {
    background: #3a3a3a;
    color: #ffffff;
    padding: 0 1 0 0;
}

FooterLabel {
    color: #ffffff;
    background: #3a3a3a;
    text-style: bold;
}

RootRequired {
    align: center middle;
    background: #2a2a2a 70%;
}

#dialog {
    width: 70%;
    max-width: 72;
    height: auto;
    background: #333333;
    border: round #f0a35e;
    padding: 1 2;
}

#root-title {
    text-style: bold;
    color: #f0a35e;
    height: 1;
}

#root-body, #root-command {
    height: auto;
    color: #e8e8e8;
}

#root-command {
    color: #8fd19a;
    text-style: bold;
}

#too-small {
    display: none;
}

.-stacked #detail {
    layout: vertical;
    height: 8;
}

.-stacked #detail-controls,
.-stacked #meters {
    width: 100%;
    height: auto;
}

.-cramped #log {
    height: 3;
}

.-tall #log {
    height: 7;
}

.-too-small #banner,
.-too-small #titlebar,
.-too-small #capacity,
.-too-small #filter,
.-too-small #procs,
.-too-small #detail,
.-too-small #log,
.-too-small #status,
.-too-small Footer {
    display: none;
}

.-too-small #too-small {
    display: block;
    dock: top;
    width: 100%;
    height: 100%;
    background: #2a2a2a;
    color: #ffffff;
    content-align: center middle;
    text-align: center;
    text-style: bold;
    padding: 1 2;
}
